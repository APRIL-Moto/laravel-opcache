{
    "name": "april-moto/laravel-opcache",
    "description": "PHP OPcache management for Laravel — forked from appstract/laravel-opcache.",
    "keywords": [
        "opcache",
        "laravel",
        "php"
    ],
    "homepage": "https://github.com/APRIL-Moto/laravel-opcache",
    "license": "MIT",
    "authors": [
        {
            "name": "Olav van Schie",
            "email": "mail@appstract.nl",
            "homepage": "https://appstract.nl",
            "role": "Original author"
        }
    ],
    "require": {
        "php": ">=8.1",
        "laravel/framework": ">=10.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Appstract\\Opcache\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Appstract\\Opcache\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Appstract\\Opcache\\OpcacheServiceProvider"
            ]
        }
    }
}
